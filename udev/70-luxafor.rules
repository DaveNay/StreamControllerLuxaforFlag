# Grants the logged-in desktop user access to the Luxafor Flag without
# root, so StreamController (running as your normal user) can talk to it
# directly over USB HID.
#
# Install with:
#   sudo cp udev/70-luxafor.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# Then unplug and replug the Flag (or reboot).
#
# The file must sort before systemd's 73-seat-late.rules, which is where
# TAG+="uaccess" is turned into an ACL for the logged-in user; in a later
# file (e.g. 99-) the tag is silently ignored and only MODE="0666" applies.
#
# Two rules are included because different Linux distros build libhidapi
# against different backends: the "hidraw" backend opens /dev/hidrawN nodes
# (permissions come from the hidraw subsystem rule), while the "libusb"
# backend opens the device directly via usbfs (permissions come from the
# usb subsystem rule). Covering both means this works regardless of which
# backend your system's libhidapi was built with.

SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="f372", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", MODE="0666", TAG+="uaccess"
